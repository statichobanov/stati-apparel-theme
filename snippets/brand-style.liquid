{%- doc -%}
  Brand style (redesign), part 1: the Montserrat font and brand CSS variables.
  Rendered in <head> only when Theme settings → Brand style is on, right after Dawn's own :root variables,
  so these values replace Dawn's font settings. The styles themselves are in assets/brand.css.

  @example
  {% render 'brand-style' %}
{%- enddoc -%}
{%- liquid
  # Sale price color = background of the sale badge's color scheme, so both change together in Customize.
  for scheme in settings.color_schemes
    if scheme.id == settings.sale_badge_color_scheme
      assign sale_color = scheme.settings.background
    endif
  endfor
-%}

{% comment %}theme-check-disable AssetPreload{% endcomment %}
<link rel="preload" as="font" href="{{ 'montserrat-cyrillic.woff2' | asset_url }}" type="font/woff2" crossorigin>
<link rel="preload" as="font" href="{{ 'montserrat-latin.woff2' | asset_url }}" type="font/woff2" crossorigin>
{% comment %}theme-check-enable AssetPreload{% endcomment %}

{% style %}
  /* Montserrat © The Montserrat Project Authors, SIL Open Font License 1.1.
     Self-hosted variable font: one file per alphabet holds all weights (300–800).
     The browser downloads a file only if the page has characters from its unicode-range.
     The Cyrillic file has Bulgarian letterforms, used on pages with lang="bg". */
  @font-face {
    font-family: 'Montserrat';
    font-style: normal;
    font-weight: 300 800;
    font-display: swap;
    src: url('{{ 'montserrat-cyrillic.woff2' | asset_url }}') format('woff2');
    unicode-range: U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;
  }

  @font-face {
    font-family: 'Montserrat';
    font-style: normal;
    font-weight: 300 800;
    font-display: swap;
    src: url('{{ 'montserrat-latin.woff2' | asset_url }}') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329,
      U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  :root {
    --font-body-family: 'Montserrat', sans-serif;
    --font-body-style: normal;
    --font-body-weight: 500;
    --font-body-weight-bold: 700;
    --font-heading-family: 'Montserrat', sans-serif;
    --font-heading-style: normal;
    --font-heading-weight: 700;
    {%- if sale_color %}
      --brand-sale-color: {{ sale_color.red }}, {{ sale_color.green }}, {{ sale_color.blue }};
    {%- endif %}
  }
{% endstyle %}
